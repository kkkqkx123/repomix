{
  "name": "kkkqkx-repomix",
  "version": "1.0.7",
  "description": "A tool to pack repository contents to single file for AI consumption",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "bin": "./bin/repomix.cjs",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json --sourceMap --declaration",
    "build-bun": "bun run build",
    "lint": "node --run lint-ts",
    "lint-ts": "tsc --noEmit",
    "test": "vitest",
    "test-coverage": "vitest run --coverage",
    "repomix": "node --run build && node --enable-source-maps --trace-warnings bin/repomix.cjs",
    "repomix-src": "node --run repomix -- --include 'src,tests'",
    "time-node": "node --run build && time node bin/repomix.cjs",
    "time-bun": "bun run build && time bun bin/repomix.cjs",
    "memory-check": "node --run repomix -- --verbose | grep Memory",
    "memory-check-one-file": "node --run repomix -- --verbose --include 'package.json' | grep Memory",
    "npm-publish": "node --run npm-publish-check-branch && node --run test-coverage && node --run build && npm publish",
    "npm-publish-check-branch": "git branch --show-current | grep -q '^main$' || (echo 'Release is only allowed from the main branch' && exit 1)",
    "npm-release-patch": "npm version patch && node --run npm-publish",
    "npm-release-minor": "npm version minor && node --run npm-publish",
    "npm-release-prerelease": "npm version prerelease && node --run npm-publish"
  },
  "keywords": [
    "repository",
    "generative-ai",
    "ai",
    "llm",
    "source-code",
    "code-analysis",
    "codebase-packer",
    "development-tool",
    "ai-assistant",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/your-org/repomix.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/repomix/issues"
  },
  "author": "",
  "homepage": "https://github.com/your-org/repomix",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "dependencies": {
    "commander": "^14.0.1",
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.2",
    "globby": "^15.0.0",
    "iconv-lite": "^0.7.0",
    "istextorbinary": "^9.5.0",
    "jschardet": "^3.1.4",
    "json5": "^2.2.3",
    "minimatch": "^10.0.3",
    "picocolors": "^1.1.1",
    "strip-comments": "^2.0.1",
    "tiktoken": "^1.0.22",
    "tinypool": "^2.0.0",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.24.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/strip-comments": "^2.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.22"
  }
}